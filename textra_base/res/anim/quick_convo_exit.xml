<?xml version="1.0" encoding="utf-8"?>
<!-- textrcs: QuickConvo (tap-to-open chat popup) EXIT animation — the mirror of quick_convo_enter.
     The full popup COLLAPSES back down into the notification-shaped bar (near-full-width, short)
     pinned to the TOP of the screen (pivotY 0%), fading out as it shrinks — so it reads as "the
     popup folding back into the notification." Wired via QuickConvoMorphAnimation on
     AppTheme.QuickConvo (res/values/styles.xml). tween + easing only (no physics bounce). ~220ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <!-- full size -> notification-shaped (0.92 wide, 0.15 tall), anchored at the top edge -->
    <scale
        android:interpolator="@android:interpolator/fast_out_linear_in"
        android:duration="220"
        android:pivotX="50%" android:pivotY="0%"
        android:fromXScale="1.0" android:toXScale="0.92"
        android:fromYScale="1.0" android:toYScale="0.15" />
    <alpha
        android:interpolator="@android:anim/accelerate_interpolator"
        android:duration="220"
        android:fromAlpha="1.0" android:toAlpha="0.0" />
</set>
