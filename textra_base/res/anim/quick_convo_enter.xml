<?xml version="1.0" encoding="utf-8"?>
<!-- textrcs: QuickConvo (tap-to-open chat popup) ENTER animation — makes the popup appear to grow
     OUT OF the heads-up notification. It STARTS at roughly the size + shape of a notification: a
     near-full-width but very SHORT bar pinned to the TOP of the screen (pivotY 0% = top edge stays
     put, where the notification sat), then EXPANDS downward to the full popup while fading in. So
     it reads as "the notification stretched open into the chat." Purely visual — the real
     notification is untouched. Wired via QuickConvoMorphAnimation on AppTheme.QuickConvo
     (res/values/styles.xml). tween + easing only (no physics bounce). ~280ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <!-- notification-shaped (0.92 wide, 0.15 tall) -> full size, anchored at the top edge -->
    <scale
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="280"
        android:pivotX="50%" android:pivotY="0%"
        android:fromXScale="0.92" android:toXScale="1.0"
        android:fromYScale="0.15" android:toYScale="1.0" />
    <alpha
        android:interpolator="@android:anim/decelerate_interpolator"
        android:duration="140"
        android:fromAlpha="0.0" android:toAlpha="1.0" />
</set>
